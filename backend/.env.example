APP_ENV=local
# Valid values: local, test, ci, preview, staging, production.
DATABASE_URL=replace-with-postgresql-url
# Production must provide an independent inbox token secret.
# Do not reuse DATABASE_URL or any other credential.
INBOX_TOKEN_SECRET=replace-with-independent-secret
# Hosted deploys can paste the Firebase service account JSON into this env var.
FIREBASE_ADMIN_CREDENTIALS_JSON=replace-with-firebase-admin-json
# Local development can keep using an ignored service account JSON file path.
FIREBASE_ADMIN_CREDENTIALS=/absolute/path/to/pickup-lane-firebase-admin.json
ALLOWED_HOSTS=replace-with-api-hosts
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_API_DOCS=true
ENABLE_DB_HEALTH=true
ENABLE_STRIPE_PAYMENTS=false
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=replace-with-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
STRIPE_CURRENCY=USD

# Cloudflare R2 storage for venue images. Keep this bucket private.
R2_ACCOUNT_ID=replace-with-r2-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=replace-with-r2-bucket-name
R2_ENDPOINT_URL=https://replace-with-r2-account-id.r2.cloudflarestorage.com
R2_UPLOAD_URL_MINUTES=15
R2_READ_URL_MINUTES=60
R2_MAX_IMAGE_BYTES=8388608
R2_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
